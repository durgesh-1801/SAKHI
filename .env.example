# ============================================================
# ARIA / SAKHI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ─────────────────────────────────────────────
APP_ENV=development
APP_NAME=ARIA-SAKHI
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://aria:aria_password@localhost:5432/aria_db
# For testing (SQLite in-memory — overridden in conftest.py)
# TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Authentication (BE1 fills in) ────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── Firebase (Push Notifications) ───────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# OR provide as JSON string:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# ─── Twilio (SMS — optional) ──────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
SMS_NOTIFICATIONS_ENABLED=false

# ─── Rate Limiting ────────────────────────────────────────────
SOS_RATE_LIMIT_PER_MINUTE=5

# ─── Escalation Defaults (overridden by user policy from BE2) ─
DEFAULT_VERIFICATION_TIMEOUT_SECONDS=30
# Configuration
DATABASE_URL=sqlite:///./sakhi.db
SECRET_KEY=sakhi-dev-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PROJECT_NAME=SAKHI Core Backend
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
